" Shared vim options and keymaps (also sets mapleader)
source ~/.vimrc

set surround
set highlightedyank
set sneak
set nerdtree
set quickscope

" Matching kickstart.nvim
map <leader><Space> <Action>(SearchEverywhere)
map <leader>sg <Action>(FindInPath)
" Custom
map <leader>sr <Action>(ReplaceInPath)

" Fallback to Rider's find+replace
nmap <C-/> <Action>(Replace)
vmap <C-/> <Action>(Replace)

map <leader>cr <Action>(RenameElement)
map <leader>ca <Action>(ShowIntentionActions)

" todo not sure if I like this for hot reload
map <leader>xr <Action>(RiderDebuggerApplyEncChagnes)

nmap <leader>yr <Action>(CopyReference)

nmap gI <Action>(ReSharperGotoImplementation)
nmap gr <Action>(FindUsages)
nmap gc <Action>(CommentByLineComment)
nmap gb <Action>(GotoSuperMethod)

nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
vmap <A-j> <Action>(MoveLineDown)
vmap <A-k> <Action>(MoveLineUp)

vmap gq <Action>(ReformatCode)
vmap gc <Action>(CommentByLineComment)

imap <C-i> <Action>(CallInlineCompletionAction)
